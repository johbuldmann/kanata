(defcfg
  process-unmapped-keys yes
)

(defvar
  ;; Timings für das "Timeless" Feeling
  tap-timeout 200
  hold-timeout 200
  idle-timeout 150 ;; Zeit ohne Tippen, bis Mods/Chords wieder scharf sind
)

;; --- NEU: Das fehlende Template ---
(deftemplate t_raw (key)
  (multi $key @tap_log)
)

(defalias
  ;; Die Logik: Springe in nomods und starte/resette den Idle-Timer
  tap_log (multi 
    (layer-switch nomods) 
    (on-idle $idle-timeout tap-vkey back_to_default)
  )
  
  ;; Nav & Symbol Aliase (bleiben gleich)
  nav_spc (tap-hold $tap-timeout $hold-timeout spc (layer-toggle nav))
  -_met (tap-hold $tap-timeout $hold-timeout / rmet)
)

(defvirtualkeys
  back_to_default (layer-switch default)
)

;; --- DEIN SRC & CHORDS (Hier nichts ändern, außer Timings) ---
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

;; Deine Chords-Definition von oben hier einfügen...
;; (Stelle sicher, dass du dort auch die Variablen $tap-timeout nutzt)

(deflayer default
  @ch_esc @ch_f1  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    @ch_w @ch_e _    _    @ch_z_top @ch_u @ch_i @ch_o _    _    _    _
  _    _    @ch_s @ch_d @ch_f _    _    @ch_j @ch_k @ch_l @ch_sem @ch_quo @ch_bsl
  lsft @ch_102 @ch_y_bot @ch_x @ch_c @ch_v @ch_b n    @ch_m @ch_com @ch_dot @-_met _
  _    _    _              @nav_spc       _    _
)

;; --- LAYER: NOMODS (Die "Sicherheitszone") ---
;; Jede Taste hier nutzt jetzt korrekt das Template (t! t_raw ...)
(deflayer nomods
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    (t! t_raw 1) (t! t_raw 2) (t! t_raw 3) (t! t_raw 4) (t! t_raw 5) (t! t_raw 6) (t! t_raw 7) (t! t_raw 8) (t! t_raw 9) (t! t_raw 0) _ _ _
  _    (t! t_raw q) (t! t_raw w) (t! t_raw e) (t! t_raw r) (t! t_raw t) (t! t_raw y) (t! t_raw u) (t! t_raw i) (t! t_raw o) (t! t_raw p) _ _ _
  _    (t! t_raw a) (t! t_raw s) (t! t_raw d) (t! t_raw f) (t! t_raw g) (t! t_raw h) (t! t_raw j) (t! t_raw k) (t! t_raw l) (t! t_raw ;) _ _
  _    (t! t_raw 102d) (t! t_raw z) (t! t_raw x) (t! t_raw c) (t! t_raw v) (t! t_raw b) (t! t_raw n) (t! t_raw m) (t! t_raw ,) (t! t_raw .) _ _
  _    _    _              spc            _    _
)

(deflayer symbols
  ;; Hier deine Symbole einfügen (wie in deinem ersten Post)
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ @q_sym @w_sym _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _
)

(deflayer nav
  ;; Hier deine Nav-Belegung einfügen (wie in deinem ersten Post)
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _
)
