(defcfg
  process-unmapped-keys yes
  windows-altgr add-lctl-release
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

(defalias
  ;; --- Layer Aktivierung (Optimiert) ---
  nav_spc (tap-hold 200 200 spc (layer-toggle nav))
  
  ;; Hier ist die Änderung: 
  ;; Wir nutzen tap-hold-press, um sicherzustellen, dass ralt 
  ;; wirklich erst gesendet wird, wenn wir es brauchen.
  sym_alt (tap-hold-release 200 200 ralt (layer-toggle symbols))

  ;; --- Spezial Taps/Holds (Linke Hand Symbol Layer) ---
  q_sym (tap-hold 200 200 S-4 (macro S-= spc))
  w_sym (tap-hold 200 200 S-2 (macro S-= S-= S-= spc))
  
  ;; --- Symbole ---
  de_caret (macro grv spc)
  de_til   (macro RA-] spc)
  de_lt    102d
  de_gt    S-102d
  de_perc  S-5
  de_bsls  RA--
  de_ast   S-]
  de_slsh  S-7
  de_pipe  RA-102d
  de_lbrc  RA-7
  de_rbrc  RA-0
  de_lbkt  RA-8
  de_rbkt  RA-9
  de_und   S-/
)

(deflayer default
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    (chord combos u) (chord combos i) _    _    _    _    _
  _    _    _    (chord combos d) _    _    _    (chord combos j) (chord combos k) (chord combos l) _    _    _
  _    _    (tap-hold 200 200 z lmet) (tap-hold 200 200 x lalt) (tap-hold 200 200 c lsft) (tap-hold 200 200 v lctl) _ _ (tap-hold 200 200 m rctl) (tap-hold 200 200 , rsft) (tap-hold 200 200 . lalt) (tap-hold 200 200 / rmet) _
  _    _    _              @nav_spc       @sym_alt _
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    pgup up   pgdn _    _    _    _
  _    _    _    _    _    _    home left down rght end  _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _
)

(deflayer symbols
  esc  @de_caret _    _    _    _    _    _    _    _    _    _    _    _
  tab  @q_sym @w_sym @de_lt @de_gt @de_perc _ @de_lbrc @de_rbrc S-. (tap-hold 200 200 S-4 (macro S-= spc)) (tap-hold 200 200 @de_til (macro = spc)) _ _
  lsft S-1 / ] S-0 S-6 \ S-8 S-9 S-, RA-q _ _
  _    @de_til @de_bsls @de_ast @de_slsh @de_pipe _ @de_lbkt @de_rbkt , . @de_und _
  _    _    _              _              _    _
)

(defchords combos 50
  (j k) bspc (k l) del (d k) esc (u i) C-bspc
  (d) d (u) u (i) i (j) j (k) k (l) l
)
