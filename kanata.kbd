(defcfg
  process-unmapped-keys yes
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl
)

(defchords combos 26
  ;; --- System & Launcher ---
  (esc f1) f24               ;; Minimize
  (w e) f24                  ;; Minimize (Alternative)
  (d f) A-spc                ;; Flow Launcher (Alt + Space)
  (s d) A-w                  ;; Window Changer (Alt + W)

  ;; --- Editieren & Wort-Navigation ---
  (y u) C-y                  ;; Undo/Redo (Je nach Layout-Logik)
  (u i) C-bspc               ;; Ctrl + Backspacj
  (i o) C-del                ;; Ctrl + Backspace (Neu)
  (j k) bspc                 ;; Backspace
  (k l) del                  ;; Delete
  (d k) esc                  ;; Escape

  ;; --- Clipboard & Undo (Reihe 4) ---
  (102d z) C-y               ;; Undo (DE: < + y)
  (z x) C-x                  ;; Cut
  (x c) C-c                  ;; Copy
  (c v) C-v                  ;; Paste
  (v b) M-v                  ;; Windows Clipboard History (Win + V)
  (; ') (tap-hold 200 200 C-c C-x) ;; Rechte Hand Copy/Cut Backup
  (' \) C-v                  ;; Rechte Hand Paste Backup

  ;; --- Symbole ---
  (, .) S-min                ;; Fragezeichen ? (Shift + ß)
  (m ,) S-1                  ;; Ausrufezeichen ! (Shift + 1)
  
  ;; Standalone Definitionen (Pflicht)
  (esc) esc (f1) f1 (w) w (e) e (s) s (d) d (f) f
  (y) y (u) u (i) i (o) o (j) j (k) k (l) l (;) ; (') ' (\) \
  (102d) 102d (z) z (x) x (c) c (v) v (b) b (m) m (,) , (.) .
)

(defalias
  nav_spc (tap-hold 200 200 spc (layer-toggle nav))

  ;; Home Row Mods (Default Layer)
  y_met (tap-hold 200 200 z lmet)
  x_alt (tap-hold 200 200 x lalt)
  c_sft (tap-hold 200 200 c lsft)
  v_ctl (tap-hold 200 200 v lctl)
  m_ctl (tap-hold 200 200 m rctl)
  ,_sft (tap-hold 200 200 , rsft)
  ._alt (tap-hold 200 200 . lalt)
  -_met (tap-hold 200 200 / rmet)

  ;; Chord Aliase für das Layout
  ch_esc (chord combos esc)  ch_f1  (chord combos f1)
  ch_w   (chord combos w)    ch_e   (chord combos e)
  ch_s   (chord combos s)    ch_d   (chord combos d)   ch_f (chord combos f)
  ch_y   (chord combos y)    ch_u   (chord combos u)   ch_i (chord combos i)
  ch_o   (chord combos o)    ch_j   (chord combos j)   ch_k (chord combos k)
  ch_l   (chord combos l)    ch_sem (chord combos ;)   ch_quo (chord combos ')
  ch_bsl (chord combos \)    ch_102 (chord combos 102d) ch_z (chord combos z)
  ch_x   (chord combos x)    ch_c   (chord combos c)   ch_v (chord combos v)
  ch_b   (chord combos b)    ch_m   (chord combos m)   ch_com (chord combos ,)
  ch_dot (chord combos .)

  ;; Nav Layer Aliase
  vd_l (tap-hold 150 150 f1 C-M-left)
  vd_r (tap-hold 150 150 f2 C-M-right)
  sel_w (macro C-left C-S-right)
  n_sh_a (tap-hold 200 200 C-a lsft)
  n_gui_y (tap-hold 200 200 C-y lmet)
  n_alt_x (tap-hold 200 200 C-x lalt)
  n_sft_c (tap-hold 200 200 C-c lsft)
  n_ctl_v (tap-hold 200 200 C-v lctl)
  v_spec (tap-hold 150 150 M-v C-S-v)
  n_ctl_pd (tap-hold 200 200 pgdn rctl)
  n_sft_pu (tap-hold 200 200 pgup rsft)
  n_alt_cr (tap-hold 200 200 C-right lalt)
)

(deflayer default
  @ch_esc @ch_f1  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    @ch_w @ch_e _    _    @ch_y @ch_u @ch_i @ch_o _    _    _    _
  _    _    @ch_s @ch_d @ch_f _    _    @ch_j @ch_k @ch_l @ch_sem @ch_quo @ch_bsl
  lsft @ch_102 @ch_z @ch_x @ch_c @ch_v @ch_b _    @ch_m @ch_com @ch_dot @-_met _
  _    _    _              @nav_spc       _    _
)

(deflayer nav
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    A-tab M-tab @vd_l @vd_r f4   _    home   @sel_w end XX  XX   XX   _
  _    @n_sh_a esc  bspc del  XX   left down up   rght S-ret _    _
  _    lrld @n_gui_y @n_alt_x @n_sft_c @n_ctl_v @v_spec C-left @n_ctl_pd @n_sft_pu @n_alt_cr lmet rctl
  _    _    _              _              _    _
)
