;; Kanata Config: Symbol Layer Update (Q=Backtick+Space Macro)
(defcfg
  process-unmapped-keys yes
)

(defvar
  ;; Zeit-Variablen für ein stabiles Gefühl
  tap-timeout 180
  hold-timeout 250      ;; Puffer für Meta, Alt, Ctrl
  shift-hold-timeout 170 ;; Aggressiver für flüssiges Shift
  spc-hold-timeout 200
  idle-timeout 180
)

(deftemplate t_raw (key)
  (multi $key @tap_log)
)

(defalias
  ;; --- Idle-Logik ---
  tap_log (multi 
    (layer-switch nomods) 
    (on-idle $idle-timeout tap-vkey back_to_default)
  )

  ;; --- Layer Toggles ---
  nav_spc (tap-hold $tap-timeout $spc-hold-timeout spc (layer-toggle nav))
  
  ;; Symbol-Trigger auf e und i
  sym_e   (tap-hold $tap-timeout $hold-timeout e (layer-toggle symbols))
  sym_i   (tap-hold $tap-timeout $hold-timeout i (layer-toggle symbols))
  
  -_met   (tap-hold $tap-timeout $hold-timeout / rmet)

  ;; --- KLASSISCHE HOME ROW MODS ---
  a_met (tap-hold $tap-timeout $hold-timeout a lmet)
  s_alt (tap-hold $tap-timeout $hold-timeout s lalt)
  d_sft (tap-hold $tap-timeout $shift-hold-timeout d lsft)
  f_ctl (tap-hold $tap-timeout $hold-timeout f lctl)

  j_ctl (tap-hold $tap-timeout $hold-timeout j rctl)
  k_sft (tap-hold $tap-timeout $shift-hold-timeout k rsft)
  l_alt (tap-hold $tap-timeout $hold-timeout l lalt)
  sem_met (tap-hold $tap-timeout $hold-timeout ; rmet)

  ;; --- Symbole ---
  de_lbrc RA-7  de_rbrc RA-0  de_lbkt RA-8  de_rbkt RA-9
  de_pipe RA-102d  de_at RA-q  de_til RA-]  de_bsls RA--
  de_caret grv  de_sqt S-\  de_min /  de_lt 102d  de_gt S-102d
  de_perc S-5  de_col S-.  de_dol S-4  de_excl S-1  de_ast S-]
  de_slsh S-7  de_eql S-0  de_amp S-6  de_hash \  de_lpar S-8
  de_rpar S-9  de_semi S-,  de_dquo S-2  de_plus ]  de_und S-/
  de_euro RA-e
  wispr S-f23
  
  ;; Backtick-Makro gegen Dead-Key-Verhalten
  m_tick_spc (macro S-= spc)

  m_gv_spc (macro S-= spc)  
  m_car_spc (macro grv spc) 
  m_bt3_spc (macro S-= spc S-= spc S-= spc)
  
  ;; Neue Mod-Taps für den Symbol Layer
  e_sym_euro (tap-hold 200 200 @de_lt @de_euro)
  w_sym (tap-hold 200 200 @de_min @m_bt3_spc)   

  ;; Chords (Kürzel)
  ch_esc (chord combos esc)  ch_f1  (chord combos f1)
  ch_w   (chord combos w)    ch_e   (chord combos e)
  ch_a   (chord combos a)    ch_s   (chord combos s)    ch_d (chord combos d) ch_f (chord combos f)
  ch_g   (chord combos g)    ch_h   (chord combos h)
  ch_z_top (chord combos y)  ch_u   (chord combos u)    ch_i (chord combos i)
  ch_o   (chord combos o)    ch_j   (chord combos j)    ch_k (chord combos k)
  ch_l   (chord combos l)    ch_sem (chord combos ;)    ch_quo (chord combos ')
  ch_bsl (chord combos \)    ch_102 (chord combos 102d) 
  ch_y_bot (chord combos z)  ch_x   (chord combos x)    ch_c (chord combos c)
  ch_v   (chord combos v)    ch_b   (chord combos b)    ch_n (chord combos n) ch_m (chord combos m)
  ch_com (chord combos ,)    ch_dot (chord combos .)

  vd_l (tap-hold 150 150 f1 C-M-left)
  vd_r (tap-hold 150 150 f2 C-M-right)
  sel_w (macro C-left C-S-right)
  n_sh_a (tap-hold 200 200 C-a lsft)
  n_gui_y (tap-hold 200 200 C-y lmet)
  n_alt_x (tap-hold 200 200 C-x lalt)
  n_sft_c (tap-hold 200 200 C-c lsft)
  n_ctl_v (tap-hold 200 200 C-v lctl)
  v_spec (tap-hold 150 150 M-v C-S-v)
  n_ctl_pd (tap-hold 200 200 pgdn rctl)
  n_sft_pu (tap-hold 200 200 pgup rsft)
  n_alt_cr (tap-hold 200 200 C-right lalt)
)

(defvirtualkeys
  back_to_default (layer-switch default)
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft 102d z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt            spc            ralt rctl
)

(defchords combos 35
  (esc f1) f24 (w e) f24 (d f) A-spc (s d) A-w (y u) C-y (u i) C-bspc (i o) C-del
  (j k) bspc (k l) del (d k) esc (102d z) C-y (z x) C-x (x c) C-c (c v) C-v (v b) M-v
  (; ') (tap-hold $tap-timeout $hold-timeout C-c C-x) (' \) C-v (, .) S-min (m ,) S-1

  (esc) esc (f1) f1 (w) w (g) g (h) h (y) y (u) u (o) o 
  (') ' (\) \ (b) b (102d) 102d (z) z (x) x (c) c (m) m (,) , (.) .

  ;; --- HRM & NEU: Symbol Trigger via Alias ---
  (a) @a_met (s) @s_alt (d) @d_sft (f) @f_ctl
  (j) @j_ctl (k) @k_sft (l) @l_alt (;) @sem_met

  (e) @sym_e 
  (i) @sym_i
  
  (v) v 
  (n) n
)

(deflayer default
  @ch_esc @ch_f1  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    @ch_w @ch_e _    _    @ch_z_top @ch_u @ch_i @ch_o _    _    _    _
  _    @ch_a @ch_s @ch_d @ch_f @ch_g @ch_h @ch_j @ch_k @ch_l @ch_sem @ch_quo @ch_bsl
  lsft @ch_102 @ch_y_bot @ch_x @ch_c @ch_v @ch_b @ch_n @ch_m @ch_com @ch_dot @-_met _
  lctl lmet lalt            @nav_spc       ralt rctl
)

(deflayer nomods
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    (t! t_raw 1) (t! t_raw 2) (t! t_raw 3) (t! t_raw 4) (t! t_raw 5) (t! t_raw 6) (t! t_raw 7) (t! t_raw 8) (t! t_raw 9) (t! t_raw 0) _ _ _
  _    (t! t_raw q) (t! t_raw w) (t! t_raw e) (t! t_raw r) (t! t_raw t) (t! t_raw y) (t! t_raw u) (t! t_raw i) (t! t_raw o) (t! t_raw p) _ _ _
  _    (t! t_raw a) (t! t_raw s) (t! t_raw d) (t! t_raw f) (t! t_raw g) (t! t_raw h) (t! t_raw j) (t! t_raw k) (t! t_raw l) (t! t_raw ;) _ _
  _    (t! t_raw 102d) (t! t_raw z) (t! t_raw x) (t! t_raw c) v (t! t_raw b) n (t! t_raw m) (t! t_raw ,) (t! t_raw .) _ _
  _    _    _              spc            _    _
)

(deflayer symbols
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  XX   @m_tick_spc @w_sym @e_sym_euro @de_gt @de_perc @m_car_spc @de_lbrc @de_rbrc @de_col @de_dol XX XX XX
  _    @de_excl @de_ast @de_slsh @de_eql @de_amp @de_hash @de_lpar @de_rpar @de_semi @de_dquo @de_sqt XX
  _    @de_til @de_plus @de_lbkt @de_rbkt @de_pipe _ @de_at @de_und , . @de_bsls XX
  _    _    _              _              _    _
)

(deflayer nav
  _    _    _    _    prev pp   next     _    _    prnt  mute vold volu    ;; Physische F-Tasten
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  _
  _    A-tab M-tab @vd_l @vd_r f4   C-y   home  @sel_w end   XX   XX   _ _
  _    @n_sh_a esc  bspc del   XX   left down up    rght ret _    _
  @wispr lrld @n_gui_y @n_alt_x @n_sft_c @n_ctl_v @v_spec C-left @n_ctl_pd @n_sft_pu @n_alt_cr lmet rctl
  _    _    _              _              _    _
)
